{
    "name": "roundly-consulting/comments-for-laravel",
    "description": "Attach polymorphic comments to any Laravel model",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "comments"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/comments-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/comments-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "roundly-consulting/approvals-for-laravel": "^1.0",
        "roundly-consulting/enums-for-laravel": "^1.0",
        "roundly-consulting/likes-for-laravel": "^1.0",
        "roundly-consulting/media-library-for-laravel": "^1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.0",
        "roundly-consulting/reports-for-laravel": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "roundly-consulting/testing-for-laravel": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Comments\\": "src",
            "RoundlyConsulting\\Comments\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Comments\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Comments\\CommentsServiceProvider"
            ]
        }
    }
}
